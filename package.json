{
  "name": "checkam-agent",
  "version": "1.0.0",
  "description": "CheckAm local battery health agent — exposes battery data to checkamm.com via localhost HTTP.",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "package": "npm run build && pkg . --out-path build",
    "package-agent": "node package-agent.js"
  },
  "pkg": {
    "assets": [
      ".env.example"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ]
  },
  "dependencies": {
    "@types/auto-launch": "^5.0.5",
    "auto-launch": "^5.0.6",
    "axios": "^1.5.0",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "esbuild": "^0.28.0",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  }
}
